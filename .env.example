# ---- Public (safe for the browser) ----
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
# Demo mode shows the migrated UI with isolated demo datasets (see src/features/demo/).
# Production MUST be false.
NEXT_PUBLIC_DEMO_MODE=true
# Supabase (optional until backend is connected)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---- Server-only (never NEXT_PUBLIC_*) ----
API_INTERNAL_BASE_URL=http://localhost:8000/api/v1
SUPABASE_SERVICE_ROLE_KEY=
API_REVALIDATE_SECRET=
